# Copy this file to .env.local and fill in the values.

# OpenAI API key used by /api/chat
OPENAI_API_KEY=

# Supabase admin connection for product data and purchase tracking
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe integration secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site URL used for checkout redirects.
NEXT_PUBLIC_SITE_URL=https://wizdomenterprizes.com
